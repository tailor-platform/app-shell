{
  "$comment": "Config for @tailor-platform/app-shell-docs-kit. See decisions/documentation-management-overhaul.md.",
  "inputs": {
    "outlines": {
      "roots": ["docs-src"]
    },
    "api": {
      "tsconfig": "packages/core/tsconfig.json",
      "entrypoint": "packages/core/src/index.ts"
    },
    "snapshots": {
      "dir": "packages/core/__snapshots__"
    }
  },
  "outputs": {
    "documents": {
      "mappings": [
        {
          "match": "docs-src/components/**",
          "dir": "docs/components"
        },
        {
          "match": "docs-src/hooks/**",
          "dir": "docs/api"
        },
        {
          "match": "docs-src/concepts/**",
          "dir": "docs/concepts"
        },
        {
          "match": "docs-src/patterns/**",
          "dir": "docs/patterns"
        },
        {
          "match": "docs-src/pages/**",
          "dir": "docs/pages"
        },
        {
          "match": "docs-src/references/**",
          "dir": "docs/references"
        },
        {
          "match": "docs-src/guides/**",
          "dir": "docs"
        }
      ]
    },
    "manifest": "docs-manifest.json",
    "skills": [
      {
        "outDir": "packages/core/skills/app-shell-patterns",
        "templatePath": "docs-src/skill/app-shell-patterns/SKILL.template.md",
        "versionSource": "packages/core/package.json"
      },
      {
        "outDir": "packages/core/skills/app-shell-upgrade",
        "templatePath": "docs-src/skill/app-shell-upgrade/SKILL.template.md",
        "sections": [],
        "migrationsSource": "docs/migrations.md",
        "repoBlobUrl": "https://github.com/tailor-platform/app-shell/blob/main",
        "versionSource": "packages/core/package.json"
      }
    ]
  },
  "policy": {
    "coverage": {
      "enforce": false,
      "exclusions": []
    },
    "skills": {
      "unclaimed": [
        {
          "dir": "docs",
          "reason": "Root guides (introduction, quickstart, design-philosophy, migrations) are for people adopting AppShell. migrations.md reaches app-shell-upgrade through its migrationsSource instead."
        },
        {
          "dir": "docs/references",
          "reason": "Specified by the docs overhaul but not built yet; nothing maps here. Decide which skill carries it when the first unit lands."
        }
      ]
    }
  }
}
