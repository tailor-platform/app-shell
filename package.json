{
  "name": "app-shell",
  "private": "true",
  "scripts": {
    "dev": "turbo watch dev --filter='./examples/*'",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test": "turbo test",
    "docs:sync": "node packages/docs-kit/dist/cli.mjs sync --root .",
    "docs:check": "node packages/docs-kit/dist/cli.mjs check --root .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "changeset:create": "changeset",
    "changeset:publish": "pnpm build && changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "lefthook": "2.1.6",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.17.0"
}
