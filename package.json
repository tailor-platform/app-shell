{
  "name": "app-shell",
  "private": "true",
  "scripts": {
    "dev": "turbo watch dev --filter='./examples/*'",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test": "turbo test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "changeset:create": "changeset",
    "changeset:publish": "pnpm build && changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "lefthook": "2.1.12",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pkg-pr-new": "0.0.88",
    "turbo": "2.9.14"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.17.0"
}
