{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "typescript", "unicorn", "oxc"],
  "jsPlugins": ["@tailor-platform/eslint-plugin-app-shell"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
  },
  "rules": {
    // React 19's JSX Transform handles React imports automatically
    "react/react-in-jsx-scope": "off",
    "no-nested-ternary": "error",
    // Consumers get this rule as a warning, because the old names still work
    // until the next major. Components read the semantic colour roles, so core
    // must not use the old names again (decisions/semantic-color-roles.md).
    "@tailor-platform/app-shell/no-deprecated-tokens": "error",
  },
  "overrides": [
    {
      // The date components hand-author the ARIA Authoring Practices widget
      // patterns (a labelled spinbutton group, a calendar grid, a date-picker
      // dialog) that react-aria emits internally. The roles and the opt-in
      // `autoFocus` prop are intentional and spec-compliant here.
      "files": ["src/components/date-field/**/*.tsx", "src/components/calendar/**/*.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
        "jsx-a11y/no-autofocus": "off",
        // The calendar wrapper carries a keydown handler purely to contain Tab
        // focus within the popover (prev → next → grid) — a focus-management
        // concern, not a clickable control.
        "jsx-a11y/no-static-element-interactions": "off",
      },
    },
    {
      // Tests name the old tokens on purpose: they check that the aliases still
      // resolve for consumers, and that components no longer render them.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "@tailor-platform/app-shell/no-deprecated-tokens": "off",
      },
    },
  ],
  "ignorePatterns": ["dist", "node_modules"],
}
