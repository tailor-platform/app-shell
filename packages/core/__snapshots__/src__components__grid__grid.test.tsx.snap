// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Grid > snapshots > alignment, flow, and per-axis gaps 1`] = `"<div data-slot="grid" class="astw:grid astw:grid-cols-[var(--grid-cols)] astw:gap-x-[var(--grid-gap-x)] astw:gap-y-[var(--grid-gap-y)] astw:grid-flow-row-dense astw:items-center astw:justify-between" style="--grid-cols: repeat(2, minmax(0, 1fr)); --grid-gap-x: calc(var(--spacing, 0.25rem) * 6); --grid-gap-y: calc(var(--spacing, 0.25rem) * 2);"><div>A</div></div>"`;

exports[`Grid > snapshots > auto-fit via minChildWidth 1`] = `"<div data-slot="grid" class="astw:grid astw:gap-x-[var(--grid-gap-x)] astw:gap-y-[var(--grid-gap-y)]" style="--grid-gap-x: calc(var(--spacing, 0.25rem) * 4); --grid-gap-y: calc(var(--spacing, 0.25rem) * 4); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));"><div>A</div><div>B</div></div>"`;

exports[`Grid > snapshots > custom column widths 1`] = `"<div data-slot="grid" class="astw:grid astw:grid-cols-[var(--grid-cols)] astw:gap-x-[var(--grid-gap-x)] astw:gap-y-[var(--grid-gap-y)]" style="--grid-cols: 280px 1fr; --grid-gap-x: calc(var(--spacing, 0.25rem) * 6); --grid-gap-y: calc(var(--spacing, 0.25rem) * 6);"><div>Side</div><div>Main</div></div>"`;

exports[`Grid > snapshots > equal columns 1`] = `"<div data-slot="grid" class="astw:grid astw:grid-cols-[var(--grid-cols)] astw:gap-x-[var(--grid-gap-x)] astw:gap-y-[var(--grid-gap-y)]" style="--grid-cols: repeat(3, minmax(0, 1fr)); --grid-gap-x: calc(var(--spacing, 0.25rem) * 4); --grid-gap-y: calc(var(--spacing, 0.25rem) * 4);"><div>A</div><div>B</div><div>C</div></div>"`;

exports[`Grid > snapshots > responsive columns 1`] = `"<div data-slot="grid" class="astw:grid astw:grid-cols-[var(--grid-cols)] astw:md:grid-cols-[var(--grid-cols-md)] astw:xl:grid-cols-[var(--grid-cols-xl)] astw:gap-x-[var(--grid-gap-x)] astw:gap-y-[var(--grid-gap-y)]" style="--grid-cols: repeat(1, minmax(0, 1fr)); --grid-cols-md: repeat(2, minmax(0, 1fr)); --grid-cols-xl: repeat(4, minmax(0, 1fr)); --grid-gap-x: calc(var(--spacing, 0.25rem) * 4); --grid-gap-y: calc(var(--spacing, 0.25rem) * 4);"><div>A</div></div>"`;

exports[`Grid > snapshots > with Grid.Item spanning 1`] = `"<div data-slot="grid" class="astw:grid astw:grid-cols-[var(--grid-cols)] astw:gap-x-[var(--grid-gap-x)] astw:gap-y-[var(--grid-gap-y)]" style="--grid-cols: repeat(4, minmax(0, 1fr)); --grid-gap-x: calc(var(--spacing, 0.25rem) * 4); --grid-gap-y: calc(var(--spacing, 0.25rem) * 4);"><div data-slot="grid-item" class="astw:[grid-column:var(--gi-col)]" style="--gi-col: span 2 / span 2;">Wide</div><div>Normal</div><div data-slot="grid-item" class="astw:[grid-column:var(--gi-col)] astw:md:[grid-column:var(--gi-col-md)] astw:[grid-row:var(--gi-row)]" style="--gi-col: 1 / -1; --gi-col-md: span 1 / span 1; --gi-row: span 2 / span 2;">Tall</div></div>"`;
