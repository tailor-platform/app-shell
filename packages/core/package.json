{
  "name": "@tailor-platform/app-shell",
  "version": "1.12.0",
  "description": "An opinionated React application framework for building ERP applications on Tailor Platform",
  "keywords": [
    "app-shell",
    "erp",
    "react",
    "routing",
    "sidebar",
    "tailor-platform",
    "vite"
  ],
  "homepage": "https://github.com/tailor-platform/app-shell/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/tailor-platform"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tailor-platform/app-shell",
    "directory": "packages/core"
  },
  "files": [
    "dist/**",
    "skills/**"
  ],
  "type": "module",
  "exports": {
    "./styles": "./dist/app-shell.css",
    "./theme.css": "./dist/theme.shims.css",
    "./themes/*": "./dist/themes/*.css",
    ".": {
      "types": "./dist/app-shell.d.ts",
      "default": "./dist/app-shell.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "lint": "oxlint -c .oxlintrc.jsonc",
    "test": "vitest run",
    "type-check": "tsc --incremental"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@internationalized/date": "3.12.2",
    "@standard-schema/spec": "^1.1.0",
    "@tailor-platform/app-shell-vite-plugin": "workspace:*",
    "@tailor-platform/auth-public-client": "^0.5.1",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "encoding-japanese": "^2.2.0",
    "lucide-react": "^1.8.0",
    "openai": "6.45.0",
    "papaparse": "^5.5.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.57.0",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.9.0",
    "postcss": "8.5.26",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.71.2",
    "react-router": "^8.3.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7",
    "react-router": "^8.3.0"
  }
}
