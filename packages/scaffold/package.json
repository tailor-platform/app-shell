{
  "name": "@tailor-platform/app-shell-scaffold",
  "version": "0.1.0",
  "description": "CLI for scaffolding compile-ready AppShell page bundles",
  "keywords": [
    "app-shell",
    "cli",
    "scaffold",
    "tailor-platform",
    "vite"
  ],
  "homepage": "https://github.com/tailor-platform/app-shell/tree/main/packages/scaffold#readme",
  "bugs": {
    "url": "https://github.com/tailor-platform"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tailor-platform/app-shell",
    "directory": "packages/scaffold"
  },
  "bin": {
    "app-shell-scaffold": "./dist/cli.mjs"
  },
  "files": [
    "dist/**",
    "templates/**"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint -c .oxlintrc.jsonc",
    "test": "node --test test/*.test.mjs",
    "type-check": "tsc --incremental"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "5.9.3"
  }
}
